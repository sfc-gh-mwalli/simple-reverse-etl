# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. This file is read by sync.py (see config.py).
# NOTHING here should be committed with real secrets. For a production job,
# pull secrets from your approved secret store (not a flat file).
# ---------------------------------------------------------------------------

# ===== Snowflake (source) =====================================================
SF_ACCOUNT=YOURORG-YOURACCOUNT
SF_USER=svc_export
SF_ROLE=EXPORT_RL
SF_WAREHOUSE=EXPORT_WH
SF_DATABASE=ANALYTICS
SF_SCHEMA=DENTAL

# Auth: "pat" for the demo, "keypair" for what you'll actually run in prod.
SF_AUTH_METHOD=pat

# --- if SF_AUTH_METHOD=pat ---
# A Programmatic Access Token string (generate in Snowsight; scope it to the
# service user + role above). Presented in place of a password.
SF_PAT=

# --- if SF_AUTH_METHOD=keypair ---
# Path to an unencrypted-or-passphrase-protected PKCS#8 private key (.p8).
SF_PRIVATE_KEY_PATH=
SF_PRIVATE_KEY_PASSPHRASE=

# ===== Target (on-prem RDBMS) =================================================
# TARGET_KIND = mysql | mssql
TARGET_KIND=mysql
TARGET_HOST=sql-host.corp.internal
TARGET_PORT=3306
TARGET_DATABASE=DENTAL_RPT
TARGET_USER=dental_loader
TARGET_PASSWORD=
# mssql only:
TARGET_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Encrypt the connection and validate the server certificate (recommended defaults).
TARGET_MSSQL_ENCRYPT=yes
TARGET_MSSQL_TRUST_SERVER_CERT=no
# Transport B load method: bulk_insert (SQL Server reads the files) or client.
TARGET_MSSQL_LOAD_METHOD=bulk_insert
# bulk_insert only: the --local-dir folder as SQL Server sees it (e.g. a UNC share).
TARGET_MSSQL_BULK_DIR=
