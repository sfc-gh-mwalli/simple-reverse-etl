# Copy this file to `.env.demo` and fill in your values, then run demo/run_demo.sh.
# `.env.demo` is gitignored so your real account details never get committed.
#
# Local demo targets only -- the passwords in the demo are throwaway passwords for
# containers on your own machine, bound to 127.0.0.1. The target connection below is
# for MySQL; with DEMO_TARGET=mssql, demo/target_env.sh sets the SQL Server values.
#
# Pick ONE Snowflake auth path:
#   A) SF_CONNECTION_NAME -> reuse an entry from ~/.snowflake/connections.toml
#      (simplest -- no secrets in this file). Overrides below still apply.
#   B) SF_ACCOUNT + SF_PAT -> paste a Snowsight Programmatic Access Token.

# ===== Snowflake source =====
# --- Option A: named connection (leave SF_PAT blank) ---
SF_CONNECTION_NAME=YOUR_CONNECTION_NAME
# --- Option B: explicit account + PAT (leave SF_CONNECTION_NAME blank) ---
SF_ACCOUNT=YOURORG-YOURACCOUNT
SF_USER=YOUR_USER
SF_AUTH_METHOD=pat
SF_PAT=

# Pins applied on top of whichever auth path is used:
SF_ROLE=YOUR_ROLE
SF_WAREHOUSE=YOUR_WAREHOUSE
SF_DATABASE=SIMPLE_REVERSE_ETL_DEMO
SF_SCHEMA=DENTAL

# ===== Local MySQL target (Docker; used when DEMO_TARGET=mysql, the default) =====
TARGET_KIND=mysql
TARGET_HOST=127.0.0.1
TARGET_PORT=3306
TARGET_DATABASE=DENTAL_RPT
TARGET_USER=root
TARGET_PASSWORD=demopw
